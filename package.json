{
  "name": "meetnotes",
  "productName": "MeetNotes",
  "version": "1.4.0",
  "description": "Personal meeting tracker with local transcription, notes and after-meeting agenda",
  "main": "src/main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/logic.test.js tests/features.test.js tests/calendar.test.js tests/capture.test.js tests/updates.test.js tests/connectors.test.js tests/reliability.test.js tests/editing.test.js tests/meetily.test.js",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@huggingface/transformers": "^4.3.1",
    "node-ical": "^0.27.3",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "local.meetnotes",
    "productName": "MeetNotes",
    "files": [
      "src/**/*",
      "renderer/**/*",
      "package.json",
      "!**/*.bak",
      "!**/*.tmp"
    ],
    "asarUnpack": [
      "src/whisper-worker.js",
      "src/vad.js",
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "levanis-design",
      "repo": "MeetNotes",
      "releaseType": "release"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MeetNotes",
      "runAfterFinish": true
    }
  },
  "author": "levanis-design"
}
